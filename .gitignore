# 비밀/환경설정
# ⚠️ 배포 전 임시로 .env 를 커밋 허용 상태로 둠. 배포 단계에서 아래 두 줄의 주석을 해제할 것.
# .env
.env.*
!.env.example
!.env
.streamlit/secrets.toml

# 사용자 개인정보/데이터
user_data/
admin_data/
*.csv
*.xlsx
*.xls

# 가상환경
envPM/
env/
venv/
.venv/

# 파이썬 캐시/빌드
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 로그/임시
*.log
piplog.txt
clone.txt
gginstall.txt
condadry.txt

# OS/에디터
.DS_Store
Thumbs.db
.vscode/
.idea/
